@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory

<div class="mb-3">
    Product ID: <span>@ProductId</span>
</div>
<div class="mb-3">
    Name: <span>@Name</span>
</div>
<Button Color="ButtonColor.Secondary" @onclick="OnClickCallback">Close</Button>
<Button Color="ButtonColor.Danger" @onclick="DeleteProductAsync">Delete</Button>

@code {
    private HttpClient _httpClient;

    protected override async Task OnInitializedAsync() {
        _httpClient = HttpClientFactory.CreateClient("Auth");
    }

    [Parameter] public int ProductId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public EventCallback<MouseEventArgs> OnClickCallback { get; set; }

    private async Task OnHideModalClick() {
        Name = string.Empty;
        await OnClickCallback.InvokeAsync();
    }

    public async Task DeleteProductAsync() {
        var result = await _httpClient.DeleteAsync(
            $"api/v1/Product/Delete?id={ProductId}");
        await OnHideModalClick();
    }
}
