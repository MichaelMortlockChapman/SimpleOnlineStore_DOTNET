@page "/products"
@inject HttpClient Http

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<AuthorizeView Roles="ADMIN">
    <Authorized>
        <CreateProductComponent OnClickSubmitCallback=@RefreshProductsEventCallback />
        <Modal @ref="updateModel" />
        <Modal @ref="deleteModel" />
        <hr />
    </Authorized>
</AuthorizeView>

@if (products == null) {
    <p><em>Loading...</em></p>
} else {
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price (AUD$)</th>
                <th>Stock</th>
                <AuthorizeView Roles="ADMIN">
                    <Authorized>
                        <th></th>
                        <th></th>
                    </Authorized>
                </AuthorizeView>

            </tr>
        </thead>
        <tbody>
            @foreach (var product in products) {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price</td>
                    <td>@product.Stock</td>
                    <AuthorizeView Roles="ADMIN">
                        <Authorized>
                            <td>
                                <Button Color="ButtonColor.Primary" @onclick="(() => ShowUpdateProductComponent(product.Id, product.Name, product.Description, product.Price, product.Stock))">Change</Button>
                                <Button Color="ButtonColor.Danger" @onclick="(() => ShowDeleteProductComponent(product.Id, product.Name))">Delete</Button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;
    private EventCallback<MouseEventArgs> RefreshProductsEventCallback;

    protected override async Task OnInitializedAsync() {
        products = await Http.GetFromJsonAsync<List<Product>>("/Product/GetNext");
        RefreshProductsEventCallback = EventCallback.Factory.Create<MouseEventArgs>(this, RefreshProducts);
    }

    private async Task RefreshProducts() {
        products = await Http.GetFromJsonAsync<List<Product>>("/Product/GetNext");        
    }

    public class Product {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public double Price { get; set; }
        public int Stock { get; set; }
    }

    private Modal updateModel = default!;
    private Modal deleteModel = default!;

    private async Task OnHideUpdateModalClick() {
        await updateModel.HideAsync();
    }

    private async Task ShowUpdateProductComponent(int ProductId, string Name, string Description, double Price, int Stock) {
        var parameters = new Dictionary<string, object>();
        parameters.Add("ProductId", ProductId);
        parameters.Add("Name", Name);
        parameters.Add("Description", Description);
        parameters.Add("Price", Price);
        parameters.Add("Stock", Stock);
        parameters.Add("OnclickCallback", EventCallback.Factory.Create<MouseEventArgs>(this, OnHideUpdateModalClick));
        parameters.Add("OnClickSubmitCallback", EventCallback.Factory.Create<MouseEventArgs>(this, RefreshProducts));
        await updateModel.ShowAsync<UpdateProductComponent>(title: "Update Product", parameters: parameters);
    }

    private async Task ShowDeleteProductComponent(int ProductId, string Name) {
        var parameters = new Dictionary<string, object>();
        parameters.Add("ProductId", ProductId);
        parameters.Add("Name", Name);
        parameters.Add("OnclickCallback", EventCallback.Factory.Create<MouseEventArgs>(this, OnHideUpdateModalClick));
        parameters.Add("OnClickSubmitCallback", EventCallback.Factory.Create<MouseEventArgs>(this, RefreshProducts));
        await updateModel.ShowAsync<DeleteProductComponent>(title: "Delete Product", parameters: parameters);
    }
}